{
  "name": "@link-foundation/code-quality",
  "version": "0.11.31",
  "description": "Public-domain multi-language quality analysis and Git code evolution for CLI, library and HTTP",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "example-package-name": "./bin/example-package-name.js",
    "code-quality": "./bin/code-quality.js"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./quality": {
      "types": "./src/quality/index.d.ts",
      "import": "./src/quality/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main",
    "test:quality": "node --test --test-timeout=30000 tests/quality-*.test.js",
    "quality:readiness": "node scripts/check-quality-readiness.mjs --strict",
    "test:types": "tsc --project tests/types/tsconfig.json"
  },
  "keywords": [
    "code-quality",
    "static-analysis",
    "code-evolution",
    "javascript",
    "typescript",
    "public-domain"
  ],
  "author": "",
  "license": "Unlicense",
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/code-quality.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.10.1",
    "command-stream": "2.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "lino-arguments": "0.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ],
    "*.sh": [
      "pipx run --no-path-check --spec shellcheck-py==0.11.0.1 shellcheck"
    ],
    ".husky/*": [
      "pipx run --no-path-check --spec shellcheck-py==0.11.0.1 shellcheck"
    ]
  },
  "allowScripts": {
    "node-pty": false
  },
  "overrides": {
    "picomatch": "npm:@ryotsu/picomatch@4.0.7-a",
    "minimatch@>=7 <11": "^11.0.4",
    "glob@>=9 <=14.0.1": "^14.0.2"
  },
  "dependencies": {
    "lino-objects-codec": "1.0.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.20.8",
    "web-tree-sitter-bash-runtime": "npm:web-tree-sitter@0.24.7"
  }
}
